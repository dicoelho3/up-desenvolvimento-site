---
/**
 * Página inicial. Partilhada entre /  (pt) e /en/ (en).
 * Cada bloco é um componente em src/components/sections — reordena-os à vontade.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import QuestionBand from '../components/sections/QuestionBand.astro';
import MissionSection from '../components/sections/MissionSection.astro';
import ProgramsSection from '../components/sections/ProgramsSection.astro';
import StatsSection from '../components/sections/StatsSection.astro';
import NeighborhoodsSection from '../components/sections/NeighborhoodsSection.astro';
import JoinSection from '../components/sections/JoinSection.astro';
import QuoteSection from '../components/sections/QuoteSection.astro';
import LatestPosts from '../components/sections/LatestPosts.astro';
import PartnersSection from '../components/sections/PartnersSection.astro';
import { testimonials } from '../data';
import { pick, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const featured = testimonials[0];
---

<BaseLayout lang={lang} route="home" title={t.home.title}>
  <HomeHero lang={lang} />
  <QuestionBand label={t.home.question.label} text={t.home.question.text} aside={t.home.question.aside} />
  <MissionSection lang={lang} />
  <ProgramsSection lang={lang} />
  <StatsSection lang={lang} />
  <NeighborhoodsSection lang={lang} />
  <JoinSection lang={lang} />
  {featured && <QuoteSection quote={pick(featured.quote, lang)} name={featured.name} role={pick(featured.role, lang)} />}
  <LatestPosts lang={lang} />
  <PartnersSection lang={lang} />
</BaseLayout>
