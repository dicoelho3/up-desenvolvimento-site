---
/**
 * Página "Contactos" — /contactos/ e /en/contact/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import LineIcon from '../components/ui/LineIcon.astro';
import Button from '../components/ui/Button.astro';
import CopyButton from '../components/ui/CopyButton.astro';
import { site } from '../config/site';
import { photo } from '../data';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.contact;
const partnerSubject = lang === 'pt' ? 'Parceria' : 'Partnership';
---

<BaseLayout lang={lang} route="contact" title={c.title} description={c.description}>
  <PageHero label={c.label} title={c.heading} lead={c.lead} image={photo('voluntaria-balao.jpg')} imageAlt={c.heroAlt} />

  <section class="contact">
    <div class="container contact__grid">
      <article class="contact-card contact-card--mustard" data-reveal>
        <LineIcon name="mail-open" size="3.4rem" />
        <h2>{c.emailTitle}</h2>
        <p>{c.emailText}</p>
        <a class="contact-card__big" href={`mailto:${site.email}`}>{site.email.split('@')[0]}<wbr />@{site.email.split('@')[1]}</a>
        <CopyButton text={site.email} label={c.copyEmail} done={c.copied} />
      </article>

      <article class="contact-card contact-card--navy" data-reveal style="--reveal-delay:100ms">
        <LineIcon name="share" size="3.4rem" color="var(--sun)" />
        <h2>{c.socialTitle}</h2>
        <p>{c.socialText}</p>
        <ul class="contact-card__social" role="list">
          <li>
            <a href={site.social.instagram.url} target="_blank" rel="noopener">
              <Icon name="instagram" size={22} />
              {site.social.instagram.label}
            </a>
          </li>
          <li>
            <a href={site.social.linkedin.url} target="_blank" rel="noopener">
              <Icon name="linkedin" size={22} />
              LinkedIn
            </a>
          </li>
          <li>
            <a href={site.social.youtube.url} target="_blank" rel="noopener">
              <Icon name="youtube" size={22} />
              YouTube
            </a>
          </li>
          <li>
            <a href={site.social.facebook.url} target="_blank" rel="noopener">
              <Icon name="facebook" size={22} />
              Facebook
            </a>
          </li>
        </ul>
      </article>

      <article class="contact-card contact-card--line" data-reveal style="--reveal-delay:200ms">
        <LineIcon name="hand-raise" size="3.4rem" color="var(--orange)" />
        <h2>{c.volunteerTitle}</h2>
        <p>{c.volunteerText}</p>
        <Button href={site.forms.volunteer} external lang={lang}>{t.common.applyMentor}</Button>
      </article>

      <article class="contact-card contact-card--line" data-reveal style="--reveal-delay:300ms">
        <LineIcon name="hand-person" size="3.4rem" color="var(--orange)" />
        <h2>{c.partnerTitle}</h2>
        <p>{c.partnerText}</p>
        <Button href={`mailto:${site.email}?subject=${partnerSubject}`} variant="navy">{t.common.writeUs}</Button>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-block-end: var(--space-3xl);
  }
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);
  }
  /* 2 × 2 em ecrãs médios e grandes: nenhum cartão fica sozinho */
  @media (min-width: 48rem) {
    .contact__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .contact-card {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-s);
    padding: var(--space-xl);
    border-radius: var(--radius-l);
  }
  .contact-card h2 {
    font-size: var(--title-block);
  }
  .contact-card--mustard {
    background: var(--mustard) url('/textures/paper-mustard.webp') center / 1000px;
    color: var(--navy-900);
    rotate: -0.8deg;
  }
  .contact-card--navy {
    background: var(--navy) url('/textures/paper-navy.webp') center / 1000px;
    color: var(--white);
    rotate: 0.6deg;
  }
  .contact-card--navy :global(.icon) {
    color: var(--sun);
  }
  .contact-card--line {
    border: 2px solid var(--navy);
  }
  .contact-card--line p {
    color: var(--text-soft);
    margin-block-end: var(--space-xs);
  }
  .contact-card__big {
    font-size: var(--step-1);
    font-weight: 600;
    /* só parte antes do "@" (nunca a meio do endereço) */
    overflow-wrap: normal;
    text-decoration-color: var(--navy);
  }
  .contact-card__social {
    display: grid;
    gap: var(--space-xs);
    padding: 0;
  }
  .contact-card__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 500;
  }
  .contact-card__social :global(.icon) {
    color: currentColor !important;
  }
</style>
