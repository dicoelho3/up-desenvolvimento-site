---
/**
 * Página "Voluntário" — /voluntario/ e /en/volunteer/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import Steps from '../components/sections/Steps.astro';
import VolunteerExtras from '../components/sections/VolunteerExtras.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Faq from '../components/sections/Faq.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Button from '../components/ui/Button.astro';
import PhotoStrip from '../components/ui/PhotoStrip.astro';
import StickyCta from '../components/ui/StickyCta.astro';
import type { LineIconName } from '../lib/line-icons';
import { site } from '../config/site';
import { photo } from '../data';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const v = t.volunteer;

// Todos os ícones desta página são da mesma família (ícones de linha desenhados à mão)
const roleIcons: LineIconName[] = ['calendar', 'heart', 'compass'];
const getsIcons: LineIconName[] = ['presentation', 'chat-dots', 'users', 'notebook'];
const stepIcons: LineIconName[] = ['note-edit', 'chat-dots', 'presentation', 'hand-person'];
---

<BaseLayout lang={lang} route="volunteer" title={v.title} description={v.description}>
  <PageHero
    label={v.hero.label}
    title={v.hero.title}
    lead={v.hero.lead}
    image={photo('hands-balloon.png')}
    cutout
  >
    <Button href={site.forms.volunteer} external lang={lang}>{t.common.applyMentor}</Button>
  </PageHero>

  <FeatureGrid
    label={v.role.label}
    title={v.role.title}
    tone="mustard"
    items={v.role.items.map((item, i) => ({ ...item, icon: `line/${roleIcons[i]!}` as const }))}
  />

  <FeatureGrid
    label={v.gets.label}
    title={v.gets.title}
    look="cards"
    items={v.gets.items.map((item, i) => ({ ...item, icon: `line/${getsIcons[i]!}` as const }))}
  />
  <section class="paper paper--cream vol-photos">
    <div class="container">
      <PhotoStrip
        photos={[
          { file: 'formacao-voluntarios-1.jpg', alt: v.photos.training1, caption: v.photos.caption1 },
          { file: 'formacao-apresentacao.jpg', alt: v.photos.training2, caption: v.photos.caption2 },
          { file: 'formacao-voluntarios-2.jpg', alt: v.photos.training3, caption: v.photos.caption3 },
          { file: 'formacao-envelopes.jpg', alt: v.photos.training4, caption: v.photos.caption4 },
        ]}
      />
    </div>
  </section>

  <Steps
    label={v.steps.label}
    title={v.steps.title}
    items={v.steps.items.map((item, i) => ({ ...item, icon: stepIcons[i] }))}
  />

  <VolunteerExtras lang={lang} />

  <Testimonials lang={lang} label={v.testimonials.label} title={v.testimonials.title} />

  <Faq label={v.faq.label} title={v.faq.title} items={v.faq.items} />

  <CtaBand title={v.cta.title} text={v.cta.text} tone="navy">
    <Button href={site.forms.volunteer} external lang={lang}>{t.common.applyMentor}</Button>
  </CtaBand>

  <!-- No telemóvel: botão de candidatura sempre à mão enquanto se lê a página -->
  <StickyCta>
    <Button href={site.forms.volunteer} external lang={lang}>{t.common.applyMentor}</Button>
  </StickyCta>
</BaseLayout>

<style>
  /* as polaroids continuam a secção anterior (mesmo fundo): sobem para junto dos cartões */
  .vol-photos {
    padding-block-start: 0;
    margin-block-start: calc(var(--space-2xl) * -1);
  }
</style>
