---
/**
 * A etiqueta "↘ Porquê?" que abre cada secção (Manual: "Fine Line").
 * A linha por baixo começa na margem esquerda do ecrã e acaba no fim do texto.
 */
interface Props {
  text: string;
  class?: string;
}
const { text, class: className } = Astro.props;
---

<p class:list={['section-label', className]}>
  <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18">
    <path d="M3 3 L16 16 M16 6.5 V16 H6.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span>{text}</span>
</p>

<style>
  .section-label {
    position: relative;
    display: inline-flex;
    align-items: flex-end;
    gap: 0.45em;
    padding-block-end: 0.35em;
    padding-inline-end: 0.6em;
    margin-block-end: var(--space-l);
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }
  /* Linha fina que vem da margem esquerda do ecrã */
  .section-label::after {
    content: '';
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: 0;
    inset-inline-start: -100vw;
    height: 1px;
    background: currentColor;
    opacity: 0.85;
  }
  .section-label svg {
    flex: none;
    translate: 0 -0.15em;
  }
  :global(.paper--navy) .section-label {
    color: var(--orange);
  }
</style>
