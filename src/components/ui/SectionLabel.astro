---
/**
 * A etiqueta "↘ Porquê?" que abre cada secção — igual aos slides da apresentação.
 */
interface Props {
  text: string;
  class?: string;
}
const { text, class: className } = Astro.props;
---

<p class:list={['section-label', className]}>
  <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18">
    <path d="M3 3 L16 16 M16 7 V16 H7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span>{text}</span>
</p>

<style>
  .section-label {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.4em;
    padding-block-end: 0.45em;
    padding-inline-end: 2.5em;
    margin-block-end: var(--space-m);
    border-block-end: 1px solid currentColor;
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0.01em;
    opacity: 0.92;
  }
  .section-label svg {
    flex: none;
    translate: 0 -0.1em;
  }
  :global(.paper--navy) .section-label {
    color: var(--sun);
  }
</style>
