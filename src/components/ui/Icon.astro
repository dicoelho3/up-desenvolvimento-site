---
/**
 * Ícones de traço, no estilo dos ícones da apresentação.
 * <Icon name="map" size={40} />
 * Para acrescentar um ícone: adiciona uma entrada ao objeto `icons` (viewBox 0 0 48 48).
 */
const icons = {
  map: '<path d="M6 12 L17 8 L31 13 L42 9 V37 L31 41 L17 36 L6 40 Z"/><path d="M17 8 V36 M31 13 V41"/>',
  megaphone: '<path d="M8 20 V29 C8 30.5 9 31 10.5 31 H15 L31 39 V10 L15 18 H10.5 C9 18 8 18.6 8 20 Z"/><path d="M15 31 L18 41 H23 L20.5 32.5"/><path d="M36 18 C38.5 20.5 38.5 28.5 36 31"/><path d="M40.5 14 C45 19 45 30 40.5 35"/>',
  people: '<circle cx="18" cy="16" r="7"/><path d="M5 40 C5 31 10.5 26 18 26 C25.5 26 31 31 31 40 Z"/><path d="M28 10.2 C29.5 9.4 31 9 32.5 9 C36.4 9 39.5 12.1 39.5 16 C39.5 19.9 36.4 23 32.5 23"/><path d="M34 26.5 C39.7 27.5 43.5 32.5 43.5 40 H35.5"/>',
  chart: '<path d="M7 40 H42"/><rect x="10" y="27" width="6" height="11" rx="3"/><rect x="21" y="20" width="6" height="18" rx="3"/><rect x="32" y="11" width="6" height="27" rx="3"/><path d="M9 21 L18 13 L25 16 L36 6 M30 6 H36 V12"/>',
  heart: '<path d="M24 40 C24 40 7 30 7 18.5 C7 13 11 9 16 9 C19.6 9 22.4 11 24 14 C25.6 11 28.4 9 32 9 C37 9 41 13 41 18.5 C41 30 24 40 24 40 Z"/>',
  book: '<path d="M24 13 C19 9.5 12 9 6 10 V37 C12 36 19 36.5 24 40 C29 36.5 36 36 42 37 V10 C36 9 29 9.5 24 13 Z"/><path d="M24 13 V40"/>',
  compass: '<circle cx="24" cy="24" r="17"/><path d="M30.5 17.5 L26.5 26.5 L17.5 30.5 L21.5 21.5 Z"/>',
  hand: '<path d="M14 26 V13 C14 11.3 15.3 10 17 10 C18.7 10 20 11.3 20 13 V22"/><path d="M20 21 V9 C20 7.3 21.3 6 23 6 C24.7 6 26 7.3 26 9 V21"/><path d="M26 21 V11 C26 9.3 27.3 8 29 8 C30.7 8 32 9.3 32 11 V23"/><path d="M32 22 V16 C32 14.3 33.3 13 35 13 C36.7 13 38 14.3 38 16 V29 C38 36 33 42 25 42 C19 42 15.5 39 12.5 34 L8.5 27 C7.7 25.6 8.2 23.8 9.6 23 C11 22.2 12.6 22.6 13.5 23.9 L14 25"/>',
  spark: '<path d="M24 5 V13 M24 35 V43 M5 24 H13 M35 24 H43 M10.5 10.5 L16 16 M32 32 L37.5 37.5 M37.5 10.5 L32 16 M16 32 L10.5 37.5"/>',
  mail: '<rect x="6" y="11" width="36" height="27" rx="4"/><path d="M7.5 13.5 L24 26 L40.5 13.5"/>',
  instagram: '<rect x="8" y="8" width="32" height="32" rx="9"/><circle cx="24" cy="24" r="7.5"/><circle cx="33.5" cy="14.5" r="1.4" fill="currentColor"/>',
  linkedin: '<rect x="7" y="7" width="34" height="34" rx="5"/><path d="M15 21 V33 M15 15 V15.5 M22 33 V21 M22 26.5 C22 23 24.5 21 27.5 21 C30.5 21 33 23 33 26.5 V33"/>',
  facebook: '<rect x="7" y="7" width="34" height="34" rx="5"/><path d="M30 14 H27.5 C24.5 14 23 16 23 19 V41 M18 25 H30"/>',
  youtube: '<rect x="6" y="11" width="36" height="26" rx="8"/><path d="M21 18.5 L30 24 L21 29.5 Z"/>',
  check: '<path d="M9 25 L19 34 L39 13"/>',
  plus: '<path d="M24 9 V39 M9 24 H39"/>',
  clock: '<circle cx="24" cy="24" r="17"/><path d="M24 14 V24 L31 28"/>',
  pin: '<path d="M24 43 C24 43 11 30.5 11 20 C11 12.8 16.8 7 24 7 C31.2 7 37 12.8 37 20 C37 30.5 24 43 24 43 Z"/><circle cx="24" cy="20" r="5"/>',
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  label?: string;
}

const { name, size = 24, strokeWidth = 2.4, class: className, label } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 48 48"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={icons[name]}
/>
