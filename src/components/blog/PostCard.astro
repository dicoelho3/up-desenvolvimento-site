---
/**
 * Cartão de um artigo do blog (usado na listagem e na página inicial).
 */
import type { CollectionEntry } from 'astro:content';
import { formatDate, postPath, type Lang } from '../../i18n';
import { postSlug } from '../../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
  headingLevel?: 'h2' | 'h3';
}
const { post, lang, headingLevel: Heading = 'h3' } = Astro.props;
const { title, description, date, cover, coverAlt } = post.data;
---

<article class="post-card">
  <div class="post-card__media">
    {
      cover ? (
        <img src={cover} alt={coverAlt ?? ''} loading="lazy" width="640" height="420" />
      ) : (
        <div class="post-card__placeholder" aria-hidden="true" />
      )
    }
  </div>
  <div class="post-card__body">
    <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
    <Heading class="post-card__title">
      <a href={postPath(postSlug(post), lang)}>{title}</a>
    </Heading>
    <p>{description}</p>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform 0.3s var(--ease-out);
  }
  .post-card:hover {
    transform: translateY(-4px);
  }
  .post-card:hover img {
    transform: scale(1.04);
  }
  .post-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--mustard);
  }
  .post-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .post-card__placeholder {
    height: 100%;
    background: var(--mustard) url('/textures/paper-mustard.webp') center / cover;
  }
  .post-card__body {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-l);
  }
  time {
    font-size: var(--step--1);
    color: var(--text-soft);
  }
  .post-card__title {
    font-size: var(--step-1);
  }
  .post-card__title a {
    text-decoration: none;
  }
  /* O link cobre o cartão inteiro */
  .post-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post-card p {
    font-size: var(--step--1);
    color: var(--text-soft);
  }
</style>
