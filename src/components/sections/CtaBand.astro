---
/**
 * Faixa final de "chamada à ação". Botões no <slot />.
 */
import Rich from '../ui/Rich.astro';
import Doodle from '../ui/Doodle.astro';

interface Props {
  title: string;
  text?: string;
  tone?: 'mustard' | 'navy';
}
const { title, text, tone = 'mustard' } = Astro.props;
---

<section class:list={['cta paper', `paper--${tone}`]}>
  <div class="container cta__inner" data-reveal>
    <Rich as="h2" text={title} class="cta__title" />
    {text && <p class="cta__text">{text}</p>}
    <div class="cta__actions">
      <Doodle name="arrows/seta-4" color={tone === 'navy' ? 'var(--orange)' : 'var(--navy)'} class="cta__arrow" />
      <slot />
    </div>
  </div>
</section>

<style>
  .cta {
    overflow: clip;
    text-align: center;
  }
  /* Seta desenhada à mão a apontar para o botão */
  :global(.cta__arrow) {
    width: clamp(5rem, 8vw, 7rem);
    inset-inline-end: calc(100% + 0.75rem);
    inset-block-start: -1.6rem;
    rotate: 8deg;
  }
  @media (max-width: 50rem) {
    section :global(.cta__arrow) {
      display: none;
    }
  }
  .cta__title {
    font-size: var(--title-section);
    max-width: 20ch;
    margin-inline: auto;
  }
  .cta__text {
    margin-block-start: var(--space-m);
    font-size: var(--step-1);
  }
  .cta__actions {
    position: relative;
    width: fit-content;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    margin-block-start: var(--space-xl);
  }
</style>
