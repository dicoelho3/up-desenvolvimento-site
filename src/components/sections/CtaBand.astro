---
/**
 * Faixa final de "chamada à ação". Botões no <slot />.
 */
import Rich from '../ui/Rich.astro';
import Doodle from '../ui/Doodle.astro';

interface Props {
  title: string;
  text?: string;
  tone?: 'mustard' | 'navy';
}
const { title, text, tone = 'mustard' } = Astro.props;
---

<section class:list={['cta paper', `paper--${tone}`]}>
  <Doodle variant="loop-arrow" color={tone === 'navy' ? 'var(--sun)' : 'var(--navy)'} class="cta__arrow" />
  <div class="container cta__inner" data-reveal>
    <Rich as="h2" text={title} class="cta__title" />
    {text && <p class="cta__text">{text}</p>}
    <div class="cta__actions">
      <slot />
    </div>
  </div>
</section>

<style>
  .cta {
    overflow: clip;
    text-align: center;
  }
  :global(.cta__arrow) {
    width: clamp(5rem, 10vw, 8rem);
    inset-block-start: 22%;
    inset-inline-start: 6%;
    rotate: 10deg;
  }
  @media (max-width: 50rem) {
    :global(.cta__arrow) {
      display: none;
    }
  }
  .cta__title {
    font-size: var(--step-4);
    max-width: 20ch;
    margin-inline: auto;
  }
  .cta__text {
    margin-block-start: var(--space-m);
    font-size: var(--step-1);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    margin-block-start: var(--space-xl);
  }
</style>
