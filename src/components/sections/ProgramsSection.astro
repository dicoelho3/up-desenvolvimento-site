---
/**
 * "Quatro programas de impacto" — dados em src/data/programs.json.
 */
import Rich from '../ui/Rich.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import Doodle from '../ui/Doodle.astro';
import { programs } from '../../data';
import { pick, useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="programs paper paper--navy">
  <Doodle name="strokes/traco-5" color="var(--sky)" class="programs__string" />
  <div class="container">
    <SectionLabel text={t.home.programs.label} />
    <h2 class="programs__title">{t.home.programs.title}</h2>

    <ol class="programs__grid" role="list">
      {
        programs.map((program, i) => (
          <li class="program" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <h3 class="program__title">{pick(program.title, lang)}</h3>
            <div class="program__body">
              <Rich as="p" text={pick(program.text, lang)} />
              <ul class="program__details">
                {pick(program.details, lang).map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
              <p class="program__frequency">{t.common[program.frequency]}</p>
            </div>
            <p class="program__highlight hand">{pick(program.highlight, lang)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .programs {
    overflow: clip;
  }
  :global(.programs__string) {
    width: clamp(10rem, 20vw, 16rem);
    inset-block-start: -5rem;
    inset-inline-end: -2rem;
    rotate: -20deg;
    opacity: 0.7;
  }
  .programs__title {
    font-size: var(--step-4);
    margin-block-end: var(--space-2xl);
  }
  .programs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-l);
    padding: 0;
  }
  .program {
    --text-soft: color-mix(in oklab, var(--navy) 78%, var(--cream));
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    background: var(--cream-50);
    color: var(--navy);
    box-shadow: 0 12px 0 -4px var(--mustard);
  }
  .program__title {
    font-family: var(--font-display);
    font-stretch: var(--font-display-stretch);
    padding: var(--space-m) var(--space-l);
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--mustard) url('/textures/paper-mustard.webp') center / 900px;
    color: var(--navy-900);
    font-size: var(--step-1);
    text-align: center;
  }
  .program__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-l);
    font-size: var(--step--1);
  }
  .program__body > :first-child {
    font-size: var(--step-0);
  }
  .program__details {
    padding-inline-start: 1.1em;
    color: var(--text-soft);
  }
  .program__frequency {
    margin-block-start: auto;
    align-self: center;
    padding: 0.4em 1.6em;
    border-radius: 999px;
    background: var(--navy);
    color: var(--white);
    font-weight: 500;
  }
  .program__highlight {
    align-self: center;
    margin-block: calc(var(--space-s) * -1) calc(var(--space-m) * -1);
    padding: 0.35em 0.9em;
    border-radius: var(--radius-s);
    background: var(--white);
    color: var(--navy);
    font-size: var(--step-1);
    rotate: -2deg;
    box-shadow: var(--shadow);
  }
  .program:nth-child(even) .program__highlight {
    rotate: 2deg;
  }
</style>
