---
/**
 * Perguntas frequentes com <details> nativo (acessível e sem JavaScript).
 */
import Rich from '../ui/Rich.astro';
import SectionLabel from '../ui/SectionLabel.astro';

interface Props {
  label: string;
  title: string;
  items: { q: string; a: string }[];
}
const { label, title, items } = Astro.props;
---

<section class="faq paper paper--cream">
  <div class="container faq__grid">
    <div>
      <SectionLabel text={label} />
      <Rich as="h2" text={title} class="faq__title" />
    </div>
    <div class="faq__list">
      {
        items.map((item) => (
          <details class="faq__item">
            <summary>
              <span>{item.q}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 56rem) {
    .faq__grid {
      grid-template-columns: 1fr 1.6fr;
    }
  }
  .faq__title {
    font-size: var(--title-section);
  }
  .faq__item {
    border-block-end: 1.5px solid var(--line);
  }
  .faq__item:first-child {
    border-block-start: 1.5px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-m);
    padding-block: var(--space-m);
    font-size: var(--step-1);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 2rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--sun-200);
    transition: background 0.2s, rotate 0.3s var(--ease-out);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 28%;
    height: 2px;
    margin-block-start: -1px;
    background: var(--navy);
    border-radius: 2px;
  }
  .faq__icon::after {
    rotate: 90deg;
    transition: rotate 0.3s var(--ease-out);
  }
  details[open] .faq__icon {
    background: var(--orange);
  }
  details[open] .faq__icon::after {
    rotate: 0deg;
  }
  .faq__item p {
    padding-block-end: var(--space-l);
    max-width: 60ch;
    color: var(--text-soft);
  }
</style>
