---
/**
 * Bairros e associações parceiras — dados em src/data/neighborhoods.json.
 * Bairros por ordem cronológica (campo "since"). Um só bloco: o mapa e, colado por baixo (na mesma moldura), o cartão do bairro escolhido.
 * Os números do mapa são os botões; o cartão tem setas para passar de bairro em bairro.
 * Sem JavaScript, os cartões aparecem todos por baixo do mapa.
 *
 * Novo bairro: acrescentar ao JSON (com coordenadas). Só se ficar fora da zona do mapa é
 * preciso gerar o mapa de novo (node scripts/build-map.mjs).
 * Referências de orientação (Lisboa, Tejo, aeroporto…): src/data/map-landmarks.json.
 */
import { Image } from 'astro:assets';
import Rich from '../ui/Rich.astro';
import LineIcon from '../ui/LineIcon.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import Doodle from '../ui/Doodle.astro';
import { neighborhoods, partnerLogo } from '../../data';
import map from '../../data/map.json';
import landmarksJson from '../../data/map-landmarks.json';
import type { LineIconName } from '../../lib/line-icons';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const nb = t.home.neighborhoods;

// Posição (em % da imagem do mapa), pela mesma projeção do gerador do mapa
const scale = 2 ** map.zoom * 256;
const toPct = (lat: number, lng: number) => {
  const r = (lat * Math.PI) / 180;
  const x = ((lng + 180) / 360) * scale - map.x0;
  const y = ((1 - Math.log(Math.tan(r) + 1 / Math.cos(r)) / Math.PI) / 2) * scale - map.y0;
  return { left: (x / map.width) * 100, top: (y / map.height) * 100 };
};
// Por ordem cronológica (ano de início da parceria): o número no mapa conta a história do UP
const hoods = [...neighborhoods]
  .sort((a, b) => a.since.localeCompare(b.since))
  .map((h, i) => ({ ...h, n: i + 1, pos: toPct(h.coords.lat, h.coords.lng) }));
const landmarks = landmarksJson.items.map((l) => ({
  ...l,
  label: l.name[lang],
  icon: (l as { icon?: LineIconName }).icon,
  pos: toPct(l.lat, l.lng),
}));
---

<section class="hoods paper paper--mustard" id="bairros">
  <Doodle name="pencil/fio-2" color="var(--navy)" class="hoods__string" />
  <div class="container hoods__layout">
    <div class="hoods__intro">
      <SectionLabel text={nb.label} />
      <Rich as="h2" text={nb.title} class="hoods__title" />
      <p>{nb.text}</p>
    </div>

    <div class="hoods__widget" data-hoods data-reveal>
      <div class="hoods__canvas" style={`aspect-ratio:${map.width} / ${map.height}`}>
        <img src={map.image} alt={nb.mapAlt} width={map.width} height={map.height} loading="lazy" decoding="async" />
        {
          landmarks.map((l) => (
            <span
              class:list={['landmark', `landmark--${l.kind}`]}
              aria-hidden="true"
              style={`left:${l.pos.left.toFixed(2)}%;top:${l.pos.top.toFixed(2)}%`}
            >
              {l.icon && <LineIcon name={l.icon} size="1.2em" />}
              {l.label}
            </span>
          ))
        }
        {
          hoods.map((h) => (
            <button
              type="button"
              class:list={['pin', { 'pin--left': h.pos.left > 60 }]}
              data-hood={h.id}
              aria-controls={`bairro-${h.id}`}
              aria-pressed="false"
              aria-label={`${h.n}. ${h.name}`}
              style={`left:${h.pos.left.toFixed(2)}%;top:${h.pos.top.toFixed(2)}%`}
            >
              <span class="pin__num" aria-hidden="true">{h.n}</span>
              <span class="pin__label" aria-hidden="true">{h.name}</span>
            </button>
          ))
        }
        <span class="hoods__credit">
          © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>
        </span>
      </div>

      <div class="hoods__info">
        <button type="button" class="hoods__arrow" data-step="-1" aria-label={nb.prev}>‹</button>
        <div class="hoods__panels" aria-live="polite">
        {
          hoods.map((h) => (
            <article class="hood" id={`bairro-${h.id}`} data-panel={h.id}>
              <span class="hood__logo">
                <Image src={partnerLogo(h.logo)} alt="" width={128} widths={[128, 256]} sizes="64px" />
              </span>
              <div class="hood__text">
                <h3 class="hood__name">
                  {h.name}
                  {h.municipality && h.municipality !== h.name && <span class="hood__place">{h.municipality}</span>}
                </h3>
                <p class="hood__partner">
                  {h.partner} · {t.common.since} {h.since}
                </p>
              </div>
            </article>
          ))
        }
        </div>
        <button type="button" class="hoods__arrow" data-step="1" aria-label={nb.next}>›</button>
      </div>
    </div>
  </div>
</section>

<script>
  // Escolher um bairro (número no mapa ou setas): mostra o cartão e destaca o marcador
  document.querySelectorAll<HTMLElement>('[data-hoods]').forEach((root) => {
    root.classList.add('is-enhanced'); // com JS: um cartão de cada vez
    const pins = [...root.querySelectorAll<HTMLButtonElement>('.pin')];
    const panels = root.querySelectorAll<HTMLElement>('[data-panel]');
    const ids = pins.map((p) => p.dataset.hood!);
    let current = 0;
    const select = (i: number) => {
      current = (i + ids.length) % ids.length;
      const id = ids[current];
      pins.forEach((pin) => {
        const on = pin.dataset.hood === id;
        pin.classList.toggle('is-active', on);
        pin.setAttribute('aria-pressed', String(on));
      });
      panels.forEach((panel) => (panel.hidden = panel.dataset.panel !== id));
    };
    pins.forEach((pin, i) => pin.addEventListener('click', () => select(i)));
    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) =>
      btn.addEventListener('click', () => select(current + Number(btn.dataset.step))),
    );
    select(0);
  });
</script>

<style>
  .hoods {
    overflow: clip;
  }
  :global(.hoods__string) {
    width: clamp(8rem, 14vw, 12rem);
    inset-block-end: -3rem;
    inset-inline-start: -3rem;
    rotate: 160deg;
    opacity: 0.85;
  }

  /* — Texto à esquerda, mapa à direita (no telemóvel, um por baixo do outro) — */
  .hoods__layout {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .hoods__layout {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }
    .hoods__widget {
      justify-self: end;
      width: 100%;
      max-width: 32rem;
    }
  }
  .hoods__title {
    font-size: var(--title-section);
    margin-block-end: var(--space-m);
  }
  .hoods__intro p {
    max-width: 38ch;
  }

  /* — O bloco: mapa + cartão na mesma moldura — */
  .hoods__widget {
    overflow: hidden;
    border: 6px solid var(--cream-50);
    border-radius: var(--radius-l);
    background: var(--cream-50);
    box-shadow:
      0 14px 0 -6px var(--navy),
      var(--shadow);
    rotate: -0.6deg;
  }
  .hoods__canvas {
    position: relative;
    overflow: hidden;
    border-radius: calc(var(--radius-l) - 6px) calc(var(--radius-l) - 6px) 0 0;
  }
  .hoods__canvas img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hoods__credit {
    position: absolute;
    inset-inline-end: 0.5rem;
    inset-block-end: 0.3rem;
    font-size: 0.62rem;
    color: var(--white);
  }
  .hoods__credit a {
    color: inherit;
  }

  /* Nomes das localidades: sempre a mesma letra (Afacad, maiúsculas espaçadas);
     o tamanho e o peso dizem a importância — cidade > concelhos > pontos de referência */
  .landmark {
    position: absolute;
    translate: -50% -50%;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-sans);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--navy);
    pointer-events: none;
  }
  .landmark--city {
    font-size: clamp(1rem, 0.75rem + 1.1vw, 1.55rem);
    font-weight: 700;
    letter-spacing: 0.32em;
    opacity: 0.7;
  }
  .landmark--town {
    font-size: clamp(0.62rem, 0.55rem + 0.3vw, 0.8rem);
    font-weight: 600;
    letter-spacing: 0.24em;
    opacity: 0.55;
  }
  .landmark--place {
    font-size: clamp(0.58rem, 0.52rem + 0.25vw, 0.72rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    opacity: 0.6;
  }
  .landmark--water {
    font-size: clamp(0.66rem, 0.58rem + 0.35vw, 0.85rem);
    font-weight: 600;
    font-style: italic;
    letter-spacing: 0.3em;
    color: var(--white);
    rotate: -28deg;
  }

  /* — Marcadores: número num círculo (+ nome no ecrã largo) — */
  .pin {
    position: absolute;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.35em;
    translate: -0.95em -50%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }
  .pin--left {
    flex-direction: row-reverse;
    translate: calc(-100% + 0.95em) -50%;
  }
  .pin__num {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.9em;
    aspect-ratio: 1;
    border: 2px solid var(--navy-900);
    border-radius: 50%;
    background: var(--cream-50);
    color: var(--navy-900);
    font-size: var(--step--1);
    font-weight: 700;
    box-shadow: 0 3px 0 var(--navy-900);
    transition:
      transform 0.25s var(--ease-out),
      background-color 0.2s;
  }
  .pin:hover .pin__num {
    transform: translateY(-2px);
  }
  .pin__label {
    padding: 0.2em 0.65em;
    border-radius: 999px;
    background: var(--cream-50);
    color: var(--navy-900);
    font-size: var(--step--1);
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 2px 0 rgb(12 38 58 / 0.25);
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .pin.is-active {
    z-index: 2;
  }
  .pin.is-active .pin__num {
    transform: scale(1.18);
    background: var(--orange);
  }
  .pin.is-active .pin__label {
    background: var(--navy);
    color: var(--white);
  }
  @media (max-width: 47.99rem) {
    .pin__label {
      display: none;
    }
  }

  /* — Cartão do bairro (colado por baixo do mapa) — */
  /* setas nas pontas, bairro ao meio */
  .hoods__info {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-s);
    border-block-start: 3px solid var(--navy);
  }
  .hoods__panels {
    display: grid;
  }
  .hood {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-2xs) var(--space-xs);
    color: var(--navy);
  }
  .hood[hidden] {
    display: none;
  }
  .is-enhanced .hood:not([hidden]) {
    animation: hood-in 0.3s var(--ease-out);
  }
  @keyframes hood-in {
    from {
      opacity: 0;
      translate: 6px 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-enhanced .hood:not([hidden]) {
      animation: none;
    }
  }
  /* sem JS: os cartões aparecem todos, separados por uma linha */
  [data-hoods]:not(.is-enhanced) .hood + .hood {
    border-block-start: 1px solid var(--line);
  }
  [data-hoods]:not(.is-enhanced) .hoods__arrow {
    display: none;
  }
  [data-hoods]:not(.is-enhanced) .hoods__info {
    grid-template-columns: 1fr;
  }
  .hood__logo {
    display: grid;
    place-items: center;
    width: 3.4rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 0 0 2px var(--sun);
    overflow: hidden;
  }
  .hood__logo :global(img) {
    width: 80%;
    height: 80%;
    object-fit: contain;
  }
  .hood__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5em;
    font-size: var(--title-card);
    line-height: 1.15;
  }
  .hood__place {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .hood__partner {
    font-size: var(--step--1);
    color: var(--text-soft);
    line-height: 1.35;
  }
  .hoods__arrow {
    display: grid;
    place-items: center;
    width: 2.2rem;
    aspect-ratio: 1;
    padding-block-end: 0.15em;
    border: 2px solid var(--navy-900);
    border-radius: 50%;
    background: var(--cream-50);
    color: var(--navy-900);
    font: inherit;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 0.2s,
      transform 0.2s var(--ease-out);
  }
  /* telemóvel: logótipo e setas mais pequenos, mais espaço para o texto */
  @media (max-width: 35.99rem) {
    .hoods__info {
      padding-inline: var(--space-2xs);
      gap: var(--space-2xs);
    }
    .hood__logo {
      width: 2.6rem;
    }
    .hoods__arrow {
      width: 1.9rem;
      font-size: 1.25rem;
    }
  }
  .hoods__arrow:hover {
    background: var(--sun);
    transform: translateY(-2px);
  }
</style>
