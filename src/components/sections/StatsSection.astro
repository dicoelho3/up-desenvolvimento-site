---
/**
 * Números de impacto — dados em src/data/stats.json.
 */
import Rich from '../ui/Rich.astro';
import LineIcon from '../ui/LineIcon.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import { stats } from '../../data';
import { path, pick, useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang).home.stats;
---

<section class="stats paper paper--cream">
  <div class="container">
    <div class="stats__head">
      <div>
        <SectionLabel text={t.label} />
        <Rich as="h2" text={t.title} class="stats__title" />
      </div>
      <p class="stats__note">
        {t.note}
        <a href={`${path('about', lang)}#impacto`}>{t.link}</a>
      </p>
    </div>

    <dl class="stats__grid">
      {
        stats.map((stat, i) => (
          <div class="stat" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <dt>{pick(stat.label, lang)}</dt>
            <dd>
              {stat.icon && <LineIcon name={stat.icon} size="2.6rem" class="stat__icon" />}
              <span class="visually-hidden">{stat.value}</span>
              <span class="stat__value" aria-hidden="true" data-count={stat.value}>{stat.value}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  // Os números contam de 0 até ao valor quando aparecem no ecrã ("+7.000", "100.000€"…).
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const els = document.querySelectorAll<HTMLElement>('.stat__value[data-count]');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          io.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const m = el.dataset.count!.match(/^(\D*)([\d.,\s]+)(.*)$/);
          if (!m) continue;
          const [, pre, num, post] = m as unknown as [string, string, string, string];
          const sep = /\d[.\s]\d{3}/.test(num) ? num.match(/\d([.\s])\d{3}/)![1]! : '';
          const target = Number(num.replace(/[.,\s]/g, ''));
          const fmt = (n: number) => (sep ? String(n).replace(/\B(?=(\d{3})+(?!\d))/g, sep) : String(n));
          const t0 = performance.now();
          const dur = 1600;
          const tick = (t: number) => {
            const p = Math.min(1, (t - t0) / dur);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = pre + fmt(Math.round(target * eased)) + post;
            if (p < 1) requestAnimationFrame(tick);
          };
          el.textContent = pre + '0' + post;
          requestAnimationFrame(tick);
        }
      },
      { rootMargin: '0px 0px -15% 0px' },
    );
    els.forEach((el) => io.observe(el));
  }
</script>

<style>
  .stat__value {
    font-variant-numeric: tabular-nums;
  }
  .stats__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-l);
    margin-block-end: var(--space-2xl);
  }
  .stats__title {
    font-size: var(--title-section);
  }
  .stats__note {
    max-width: 34ch;
    font-size: var(--step--1);
    color: var(--text-soft);
  }
  .stats__note a {
    display: block;
    margin-block-start: 0.4em;
    color: var(--navy);
    font-weight: 500;
  }
  /* 2×2 no telemóvel (4 cartões altos empilhados obrigavam a muito scroll); 4 numa linha no ecrã largo */
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s);
  }
  @media (min-width: 50rem) {
    .stats__grid {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
      gap: var(--space-m);
    }
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: center;
    gap: var(--space-xs);
    min-height: 11rem;
    padding: var(--space-l) var(--space-s);
    container-type: inline-size;
    border-radius: var(--radius);
    background: var(--mustard) url('/textures/paper-mustard.webp') center / 900px;
    color: var(--navy-900);
    text-align: center;
  }
  .stat:nth-child(odd) {
    rotate: -1deg;
  }
  .stat:nth-child(even) {
    rotate: 1.2deg;
  }
  .stat dd {
    font-family: var(--font-display);
    font-stretch: var(--font-display-stretch);
    /* o número encolhe se o cartão for estreito (ex. "100.000€" no telemóvel) */
    font-size: min(var(--step-3), 15cqi);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat dd {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
  }
  .stat dt {
    font-size: var(--step--1);
    line-height: 1.35;
  }
</style>
