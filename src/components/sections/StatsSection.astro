---
/**
 * Números de impacto — dados em src/data/stats.json.
 */
import Rich from '../ui/Rich.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import { stats } from '../../data';
import { path, pick, useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang).home.stats;
---

<section class="stats paper paper--cream">
  <div class="container">
    <div class="stats__head">
      <div>
        <SectionLabel text={t.label} />
        <Rich as="h2" text={t.title} class="stats__title" />
      </div>
      <p class="stats__note">
        {t.note}
        <a href={`${path('about', lang)}#impacto`}>{t.link}</a>
      </p>
    </div>

    <dl class="stats__grid">
      {
        stats.map((stat, i) => (
          <div class="stat" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <dt>{pick(stat.label, lang)}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .stats__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-l);
    margin-block-end: var(--space-2xl);
  }
  .stats__title {
    font-size: var(--step-4);
  }
  .stats__note {
    max-width: 34ch;
    font-size: var(--step--1);
    color: var(--text-soft);
  }
  .stats__note a {
    display: block;
    margin-block-start: 0.4em;
    color: var(--navy);
    font-weight: 500;
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-m);
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: center;
    gap: var(--space-xs);
    min-height: 11rem;
    padding: var(--space-l);
    border-radius: var(--radius);
    background: var(--mustard) url('/textures/paper-mustard.webp') center / 900px;
    color: var(--navy-900);
    text-align: center;
  }
  .stat:nth-child(odd) {
    rotate: -1deg;
  }
  .stat:nth-child(even) {
    rotate: 1.2deg;
  }
  .stat dd {
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .stat dt {
    font-size: var(--step--1);
    line-height: 1.35;
  }
</style>
