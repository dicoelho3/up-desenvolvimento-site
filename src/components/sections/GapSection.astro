---
/**
 * "O UP nasceu para fechar uma lacuna…" — dois lados ligados por um fio.
 */
import Rich from '../ui/Rich.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import BrandIcon from '../ui/BrandIcon.astro';
import Doodle from '../ui/Doodle.astro';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const g = useTranslations(lang).about.gap;
---

<section class="gap paper paper--mustard">
  <div class="container">
    <SectionLabel text={g.label} />
    <Rich as="h2" text={g.title} class="gap__title" />

    <div class="gap__grid">
      <div class="gap__side" data-reveal>
        <div class="gap__box">
          <BrandIcon name="line/home" tone="cream" size={68} />
          <h3>{g.left.title}</h3>
        </div>
        <Rich as="p" text={g.left.text} />
      </div>

      <Doodle name="pencil/fio-3" color="var(--navy)" inline class="gap__thread" />

      <div class="gap__side" data-reveal style="--reveal-delay:150ms">
        <div class="gap__box">
          <BrandIcon name="line/flag" tone="cream" size={68} />
          <h3>{g.right.title}</h3>
        </div>
        <Rich as="p" text={g.right.text} />
      </div>
    </div>
  </div>
</section>

<style>
  .gap__title {
    font-size: var(--title-section);
    max-width: 22ch;
    margin-block-end: var(--space-2xl);
  }
  .gap__grid {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }
  @media (min-width: 56rem) {
    .gap__grid {
      grid-template-columns: 1fr 8rem 1fr;
    }
  }
  .gap__side {
    display: grid;
    gap: var(--space-l);
  }
  .gap__box {
    display: grid;
    justify-items: center;
    gap: var(--space-s);
    padding: var(--space-xl) var(--space-l);
    border-radius: var(--radius-l);
    background: var(--navy) url('/textures/paper-navy.webp') center / 900px;
    color: var(--white);
    text-align: center;
  }
  .gap__box h3 {
    font-size: var(--title-block);
  }
  .gap__side p {
    max-width: 40ch;
  }
  :global(.gap__thread) {
    width: 100%;
    align-self: center;
    margin-block-start: -5rem;
    rotate: -8deg;
  }
  /* Em ecrã estreito o fio passaria por cima do texto: esconde-se */
  @media (max-width: 55.99rem) {
    section :global(.gap__thread) {
      display: none;
    }
  }
</style>
