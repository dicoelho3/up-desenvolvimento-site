---
/**
 * Testemunhos de voluntários — dados em src/data/testimonials.json.
 * Cada cartão parece um post-it ligeiramente torto.
 */
import Rich from '../ui/Rich.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import { testimonials } from '../../data';
import { pick, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  label: string;
  title: string;
}
const { lang, label, title } = Astro.props;
---

<section class="testimonials paper paper--mustard">
  <div class="container">
    <SectionLabel text={label} />
    <Rich as="h2" text={title} class="testimonials__title" />
    <ul class="testimonials__grid" role="list">
      {
        testimonials.map((item, i) => (
          <li data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <figure class="note">
              <blockquote>
                <p>“{pick(item.quote, lang)}”</p>
              </blockquote>
              <figcaption>
                <span class="note__name hand">{item.name}</span>
                <span class="note__role">{pick(item.role, lang)}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .testimonials__title {
    font-size: var(--step-4);
    margin-block-end: var(--space-2xl);
  }
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-l);
    padding: 0;
    align-items: start;
  }
  .note {
    position: relative;
    display: grid;
    gap: var(--space-m);
    padding: var(--space-xl) var(--space-l) var(--space-l);
    border-radius: 4px 4px var(--radius) 4px;
    background: var(--cream-50);
    box-shadow: 0 18px 30px -22px rgb(21 35 77 / 0.6);
    rotate: -1.5deg;
  }
  li:nth-child(2) .note {
    rotate: 1.2deg;
    margin-block-start: var(--space-l);
  }
  li:nth-child(3) .note {
    rotate: -0.6deg;
  }
  /* Fita-cola no topo */
  .note::before {
    content: '';
    position: absolute;
    inset-block-start: -0.8rem;
    inset-inline-start: 50%;
    width: 5.5rem;
    height: 1.6rem;
    translate: -50% 0;
    rotate: -3deg;
    background: color-mix(in oklab, var(--sun) 70%, transparent);
  }
  blockquote p {
    font-size: var(--step-1);
    line-height: 1.45;
  }
  figcaption {
    display: grid;
  }
  .note__name {
    font-size: var(--step-2);
    color: var(--orange);
  }
  .note__role {
    font-size: var(--step--1);
    color: var(--text-soft);
  }
</style>
