---
/**
 * Grelha de pontos com ícone, título e texto.
 * Usada em "O que faz um mentor", "O que levas", "Metodologia", etc.
 */
import Rich from '../ui/Rich.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import BrandIcon, { type AnyBrandIcon } from '../ui/BrandIcon.astro';

interface Item {
  title: string;
  text: string;
  icon?: AnyBrandIcon;
}
interface Props {
  label: string;
  title: string;
  items: Item[];
  tone?: 'cream' | 'mustard' | 'navy';
  /** "cards": caixas azuis (estilo Metodologia UP); "plain": texto solto com numeração. */
  look?: 'cards' | 'plain';
  id?: string;
}
const { label, title, items, tone = 'cream', look = 'plain', id } = Astro.props;
---

<section class:list={['features paper', `paper--${tone}`, `features--${look}`]} id={id}>
  <div class="container">
    <SectionLabel text={label} />
    <Rich as="h2" text={title} class="features__title" />
    <ul class="features__grid" role="list" style={`--count:${items.length}`}>
      {
        items.map((item, i) => (
          <li class="feature" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            {item.icon ? (
              <BrandIcon name={item.icon} tone={look === 'cards' ? 'cream' : tone === 'mustard' ? 'cream' : 'orange'} size={60} class="feature__icon" />
            ) : (
              <span class="feature__num hand" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            )}
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features__title {
    font-size: var(--step-4);
    margin-block-end: var(--space-2xl);
    max-width: 18ch;
  }
  .features__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-xl) var(--space-l);
    padding: 0;
  }
  /* Cada ponto ocupa 3 linhas da grelha (ícone, título, texto) partilhadas por todos:
     assim os títulos e os textos ficam alinhados mesmo quando um título ocupa 2 linhas. */
  .feature {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    align-content: start;
    row-gap: var(--space-s);
  }
  .feature h3 {
    align-self: start;
  }
  .feature h3 {
    font-size: var(--step-1);
  }
  .feature p {
    color: var(--text-soft);
  }
  .feature__num {
    font-family: var(--font-display);
    font-stretch: var(--font-display-stretch);
    font-style: normal;
    font-weight: 800;
    font-size: var(--step-3);
    color: var(--orange);
  }
  .paper--mustard .feature__num {
    color: var(--navy);
  }
  :global(.feature__icon) {
    margin-block-end: var(--space-2xs);
  }

  /* Estilo "cartões" — como a Metodologia UP da apresentação.
     Grelha fixa (1 → 2 → todas numa linha) para nunca ficar um cartão sozinho. */
  .features--cards .features__grid {
    grid-template-columns: 1fr;
  }
  @media (min-width: 36rem) {
    .features--cards .features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .features--cards .features__grid {
      grid-template-columns: repeat(var(--count), 1fr);
    }
  }
  .features--cards .feature {
    justify-items: center;
    padding: var(--space-xl) var(--space-m);
    border-radius: var(--radius);
    background: var(--navy) url('/textures/paper-navy.webp') center / 900px;
    color: var(--white);
    text-align: center;
  }
  .features--cards .feature:nth-child(odd) {
    rotate: -0.8deg;
  }
  .features--cards .feature:nth-child(even) {
    rotate: 0.8deg;
  }
  /* Nos cartões (4 colunas) o título é mais pequeno para caber numa coluna estreita */
  .features--cards .feature h3 {
    font-size: clamp(1rem, 0.85rem + 0.3vw, 1.12rem);
    letter-spacing: -0.01em;
  }
  .features--cards .feature p {
    color: color-mix(in oklab, var(--white) 80%, var(--navy));
  }
</style>
