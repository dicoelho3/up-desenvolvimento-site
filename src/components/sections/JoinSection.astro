---
/**
 * Dois caminhos para participar: ser mentor ou apoiar.
 */
import SectionLabel from '../ui/SectionLabel.astro';
import Button from '../ui/Button.astro';
import BrandIcon from '../ui/BrandIcon.astro';
import Doodle from '../ui/Doodle.astro';
import { path, useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang).home.join;
---

<section class="join paper paper--cream">
  <div class="container">
    <SectionLabel text={t.label} />
    <div class="join__grid">
      <article class="join-card join-card--navy" data-reveal>
        <BrandIcon name="line/hand-raise" tone="cream" size={68} />
        <h2>{t.mentor.title}</h2>
        <p>{t.mentor.text}</p>
        <Button href={path('volunteer', lang)} variant="orange">{t.mentor.cta}</Button>
      </article>

      <article class="join-card join-card--mustard" data-reveal style="--reveal-delay:120ms">
        <Doodle name="doodles/sparks" color="var(--orange)" class="join__sparks" />
        <BrandIcon name="line/heart" tone="cream" size={68} />
        <h2>{t.sponsor.title}</h2>
        <p>{t.sponsor.text}</p>
        <Button href={path('support', lang)} variant="navy">{t.sponsor.cta}</Button>
      </article>
    </div>
  </div>
</section>

<style>
  .join__grid {
    position: relative;
    display: grid;
    gap: var(--space-l);
  }
  @media (min-width: 50rem) {
    .join__grid {
      grid-template-columns: 1fr 1fr;
    }
    .join-card--navy {
      rotate: -1deg;
    }
    .join-card--mustard {
      rotate: 1deg;
      margin-block-start: var(--space-xl);
    }
  }
  /* Brilhos a sair do canto superior direito: o ponto de onde os traços irradiam
     (20% da largura, 85% da altura do desenho espelhado) fica em cima do canto */
  :global(.join__sparks) {
    --w: 3.4rem;
    width: var(--w);
    inset-inline-end: auto;
    inset-inline-start: calc(100% - var(--w) * 0.2 + 0.15rem);
    inset-block-start: calc(var(--w) * -0.652 - 0.15rem);
    scale: -1 1;
    z-index: 1;
  }
  /* telemóvel: o canto está perto da borda do ecrã — brilhos mais pequenos */
  @media (max-width: 49.99rem) {
    :global(.join__sparks) {
      --w: 1.5rem;
      inset-inline-start: calc(100% - var(--w) * 0.2 - 0.35rem);
    }
  }
  .join-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-m);
    padding: var(--space-xl);
    border-radius: var(--radius-l);
  }
  .join-card h2 {
    font-size: var(--title-block);
  }
  .join-card p {
    max-width: 36ch;
    margin-block-end: var(--space-s);
  }
  .join-card--navy {
    background: var(--navy) url('/textures/paper-navy.webp') center / 1000px;
    color: var(--white);
  }
  .join-card--navy :global(.icon) {
    color: var(--sun);
  }
  .join-card--mustard {
    background: var(--mustard) url('/textures/paper-mustard.webp') center / 1000px;
    color: var(--navy-900);
  }
</style>
