---
import { Image } from 'astro:assets';
import teamCircle from '../../assets/photos/team-circle.png';
import Rich from '../ui/Rich.astro';
import Button from '../ui/Button.astro';
import Doodle from '../ui/Doodle.astro';
import TitleArrow from '../ui/TitleArrow.astro';
import { site } from '../../config/site';
import { path, useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero">
  <Doodle name="pencil/fio-1" color="var(--orange)" class="hero__string" />

  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow">
        <span class="hero__dot" aria-hidden="true"></span>
        {t.home.hero.eyebrow}
      </p>
      <h1 class="hero__title">
        <Rich text={t.home.hero.title} />
        <TitleArrow />
      </h1>
      <p class="lead">{t.home.hero.lead}</p>
      <div class="hero__actions">
        <Button href={site.forms.volunteer} external lang={lang}>{t.common.applyMentor}</Button>
        <Button href={path('volunteer', lang)} variant="ghost">{t.home.hero.secondary}</Button>
      </div>
    </div>

    <div class="hero__visual">
      <Image
        src={teamCircle}
        alt=""
        widths={[480, 720, 1000, 1400]}
        sizes="(min-width: 60rem) 48vw, 95vw"
        loading="eager"
        fetchpriority="high"
        class="hero__photo"
      />
      <p class="hero__note hand" aria-hidden="true">
        {t.home.hero.note}
        <Doodle name="arrows/seta-1" color="var(--navy)" inline class="hero__arrow" />
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: var(--space-xl) var(--space-3xl);
  }
  :global(.hero__string) {
    width: clamp(9rem, 16vw, 15rem);
    inset-block-start: -4rem;
    inset-inline-end: -3rem;
    rotate: 12deg;
  }
  .hero__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-size: var(--step--1);
    font-weight: 500;
    margin-block-end: var(--space-m);
  }
  /* O balão do logótipo UP (recortado do símbolo oficial), com um fio curto */
  .hero__dot {
    position: relative;
    flex: none;
    width: 1.35em;
    aspect-ratio: 232 / 287;
    margin-block-end: 0.6em;
    background: url('/brand/balloon.webp') center / contain no-repeat;
    transform-origin: 50% 100%;
    animation: float 4s ease-in-out infinite;
  }
  .hero__dot::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 1.5px;
    height: 0.65em;
    translate: -50% 0;
    background: var(--orange);
  }
  .hero__title {
    font-size: var(--title-page);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-block-end: var(--space-l);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-xl);
  }

  .hero__visual {
    position: relative;
    width: 100%;
    max-width: 44rem;
    justify-self: center;
  }
  /* Em ecrã largo a foto cresce para a margem direita */
  @media (min-width: 60rem) {
    .hero__visual {
      width: calc(100% + 1rem);
      max-width: 46rem;
      justify-self: end;
      margin-inline-end: -1rem;
    }
  }
  @media (min-width: 80rem) {
    .hero__visual {
      width: calc(100% + 5rem);
      margin-inline-end: -4rem;
    }
  }
  :global(.hero__photo) {
    width: 100%;
    height: auto;
  }
  /* Legenda por baixo da foto (nunca por cima), com a seta a apontar para ela */
  .hero__note {
    display: flex;
    align-items: flex-end;
    gap: 0.4em;
    margin-block-start: var(--space-xs);
    padding-inline-start: 8%;
    rotate: -3deg;
    font-size: var(--step-2);
    color: var(--navy);
  }
  :global(.hero__arrow) {
    width: 2.6rem;
    margin-block-end: 0.5em;
    /* espelhada e rodada 90° para a direita: aponta para cima, para a foto */
    scale: -1 1;
    rotate: 90deg;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(-4deg);
    }
    50% {
      transform: translateY(-4px) rotate(4deg);
    }
  }
</style>
