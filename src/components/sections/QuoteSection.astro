---
/**
 * Uma citação em destaque (testemunho) sobre fundo azul.
 */
import Doodle from '../ui/Doodle.astro';

interface Props {
  quote: string;
  name: string;
  role?: string;
}
const { quote, name, role } = Astro.props;
---

<section class="quote paper paper--navy">
  <Doodle name="strokes/traco-2" color="var(--orange)" class="quote__string" />
  <figure class="container--narrow" data-reveal>
    <svg class="quote__mark" aria-hidden="true" viewBox="0 0 64 48" width="64" height="48">
      <path
        d="M4 44 C4 26 10 10 26 4 L28 9 C19 14 16 21 16 26 H26 V44 Z M36 44 C36 26 42 10 58 4 L60 9 C51 14 48 21 48 26 H58 V44 Z"
        fill="currentColor"></path>
    </svg>
    <blockquote>
      <p>{quote}</p>
    </blockquote>
    <figcaption>
      <span class="quote__name">{name}</span>
      {role && <span class="quote__role">{role}</span>}
    </figcaption>
  </figure>
</section>

<style>
  .quote {
    overflow: clip;
    text-align: center;
  }
  :global(.quote__string) {
    width: clamp(9rem, 16vw, 14rem);
    inset-block-start: -2rem;
    inset-inline-start: -2rem;
    rotate: -60deg;
  }
  .quote__mark {
    margin-inline: auto;
    margin-block-end: var(--space-l);
    color: var(--orange);
  }
  blockquote p {
    font-size: var(--step-3);
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  figcaption {
    display: grid;
    gap: 0.2em;
    margin-block-start: var(--space-xl);
  }
  .quote__name {
    font-family: var(--font-sans);
    font-style: italic;
    font-size: var(--step-3);
    color: var(--sun);
    font-weight: 600;
  }
  .quote__role {
    font-size: var(--step--1);
    color: var(--text-soft);
  }
</style>
