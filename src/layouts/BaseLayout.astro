---
/**
 * Esqueleto de todas as páginas: <head> (SEO, idiomas, partilha), header, conteúdo e footer.
 */
import '@fontsource-variable/lexend';
import '@fontsource/caveat/600.css';
import '../styles/base.css';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../config/site';
import { path, useTranslations, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Página atual (para o menu e para o link de idioma). */
  route?: RouteKey;
  /** Endereço da mesma página no outro idioma (se não for uma rota do menu, ex.: artigo do blog). */
  alternateUrl?: string;
  /** Imagem para partilha nas redes sociais. */
  image?: string;
}

const { lang, title, description, route, image = '/og-image.jpg' } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const alternateUrl = Astro.props.alternateUrl ?? path(route ?? 'home', otherLang);

const fullTitle = route === 'home' ? `${site.name} · ${title}` : `${title} · ${site.name}`;
const metaDescription = description ?? t.meta.siteDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(alternateUrl, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-PT' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={otherLang} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={lang === 'pt' ? canonical : alternate} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1f3366" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_PT' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Marca que o JS está ativo (para as animações de entrada não esconderem nada sem JS) -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header lang={lang} current={route} alternateUrl={alternateUrl} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Revela elementos com [data-reveal] quando entram no ecrã.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      items.forEach((el) => io.observe(el));
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: var(--gutter);
        top: -4rem;
        z-index: 100;
        padding: 0.6em 1em;
        background: var(--navy);
        color: var(--white);
        border-radius: var(--radius-s);
      }
      .skip-link:focus {
        top: 0.75rem;
      }
    </style>
  </body>
</html>
